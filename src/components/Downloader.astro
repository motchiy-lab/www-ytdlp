---
import SiteLayout from "../layouts/SiteLayout.astro";
import AvailableServices from "./AvailableServices.astro";

interface FormatGroup {
    title: string;
    buttons: { label: string; value: string }[];
    more?: { title: string; buttons: { label: string; value: string }[] };
}

interface Props {
    pageTitle: string;
    description: string;
    canonicalPath: string;
    platform:
        | "youtube"
        | "bilibili"
        | "niconico"
        | "soundcloud"
        | "tiktok"
        | "twitch";
    heading: string;
    placeholder: string;
    groups: FormatGroup[];
    noticeDate?: string;
    showBrand?: boolean;
}

const {
    pageTitle,
    description,
    canonicalPath,
    platform,
    heading,
    placeholder,
    groups,
    noticeDate,
    showBrand = true,
} = Astro.props;
const hasNotice = false;
---

<SiteLayout
    title={pageTitle}
    description={description}
    canonicalPath={canonicalPath}
>
    <hr />
    <div class="documents-container">
        <br />
        {hasNotice && (
            <div class="message-container">
                <slot name="notice" />
                {noticeDate && <i>{noticeDate}</i>}
            </div>
        )}
        {showBrand && <p style="text-align:center;">yt-dlp on Motchiy</p>}
        <h1 style="text-align:center;">{heading}</h1>
        <form class="download-form" data-platform={platform}>
            <input
                type="text"
                name="videoUrl"
                placeholder={placeholder}
                size="50"
                required
            />
            <br />
            <br />
            <div class="documents-container">
                {groups.map((group) => (
                    <div>
                        <h3>{group.title}</h3>
                        {group.buttons.map((button) => (
                            <button
                                type="submit"
                                name="fileFormat"
                                value={button.value}
                            >
                                {button.label}
                            </button>
                        ))}
                        {group.more && (
                            <>
                                <br />
                                <br />
                                <details>
                                    <summary>{group.more.title}</summary>
                                    {group.more.buttons.map((button) => (
                                        <button
                                            type="submit"
                                            name="fileFormat"
                                            value={button.value}
                                        >
                                            {button.label}
                                        </button>
                                    ))}
                                </details>
                            </>
                        )}
                    </div>
                ))}
            </div>
        </form>
        <p class="request-status" role="status" aria-live="polite"></p>
        <dialog class="loading-modal" id="loadingModal" aria-labelledby="loadingModalTitle">
            <div class="modal-content">
                <button class="modal-close" type="button" aria-label="閉じる">
                    &times;
                </button>
                <h2 id="loadingModalTitle">処理中なのでちょっとまってくださいね</h2>
                <img
                    src="/imgs/loading.jpg"
                    alt="ローディング中のカールツァイス"
                    class="dlpicture"
                />
                <p>
                    ダウンロードの準備をしています。完了まで数十秒ほどかかることがあります。
                </p>
                <p class="loading-status" role="status" aria-live="polite"></p>
            </div>
        </dialog>
        <br />
        <AvailableServices />
    </div>
</SiteLayout>

<script>
    import "../scripts/request-download";
</script>
