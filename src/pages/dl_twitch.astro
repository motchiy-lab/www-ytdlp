---
import Downloader from "../components/Downloader.astro";
const description =
    "yt-dlp on Motchiyでは、Twitchの動画、音声、サムネイルのダウンロードが行えます。完全無料でログインなどは不要、安全に動画をダウンロードできます！";
const groups = [
    { title: "動画", buttons: [{ label: "動画", value: "mp4" }] },
    { title: "音声", buttons: [{ label: "音声", value: "mp3" }] },
    { title: "サムネイル", buttons: [{ label: "JPEG", value: "jpg" }] },
];
---

<Downloader
    pageTitle="yt-dlp on Motchiy - Twitch動画を完全無料でダウンロード！"
    description={description}
    canonicalPath="/dl_twitch.html"
    platform="twitch"
    heading="Twitch動画ダウンロード"
    placeholder="Twitch動画のURLを入力"
    groups={groups}
>
    <Fragment slot="notice">
        現時点では、<b>Twitchダウンローダーは試験的な運用を行っています。</b>
        <br />
        今後のサービスの動作次第では、Twitchダウンローダーは削除される可能性もあります。
        <br />
        なお、現時点で正式な運用が行われているサービスについては、
        <a href="/services.html">対応サービス</a>のページをご覧ください。
    </Fragment>
</Downloader>
